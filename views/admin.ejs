<%- include('partials/header', { title: 'Admin' }) %>
<h1>Panneau admin</h1>
<% if (ok) { %><p class="notice"><%= ok %></p><% } %>

<div class="stats">
  <div class="stat"><strong><%= stats.today %></strong><span>Visiteurs aujourd'hui</span></div>
  <div class="stat"><strong><%= stats.week %></strong><span>7 derniers jours</span></div>
  <div class="stat"><strong><%= stats.total %></strong><span>Visiteurs au total</span></div>
  <div class="stat"><strong><%= stats.users %></strong><span>Membres inscrits</span></div>
  <div class="stat"><strong><%= stats.banned %></strong><span>Bannis</span></div>
</div>

<p class="btn-row">
  <a class="btn" href="/admin/anime/new">+ Nouvel anime</a>
  <a class="btn" href="/admin/users">👥 Gérer les membres</a>
  <% if (user.role === 'owner') { %><a class="btn" href="/admin/backup">💾 Sauvegarde</a><% } %>
</p>

<table class="table">
  <tr><th>Titre</th><th>Actions</th></tr>
  <% animes.forEach(a => { %>
    <tr>
      <td><%= a.title %></td>
      <td class="actions">
        <a href="/admin/anime/<%= a.id %>/episodes">Épisodes</a>
        <a href="/admin/anime/<%= a.id %>/edit">Modifier</a>
        <form method="POST" action="/admin/anime/<%= a.id %>/delete" onsubmit="return confirm('Supprimer cet anime et tous ses épisodes ?')">
          <button class="link-danger">Supprimer</button>
        </form>
      </td>
    </tr>
  <% }) %>
</table>
<%- include('partials/footer') %>
